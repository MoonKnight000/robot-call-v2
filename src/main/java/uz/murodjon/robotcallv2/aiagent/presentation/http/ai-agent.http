### 1. Get AI Agent Templates (BUSINESS, SUPPORT, MEDICAL, BLANK)
GET http://localhost:8080/api/ai-agents/templates?language=uz-UZ
Authorization: Bearer {{auth_token}}

### 2. Create AI Agent (behaviour, STT/TTS and analysis in one)
POST http://localhost:8080/api/ai-agents
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Savdo maslahatchisi",
  "description": "Mijozlar bilan aloqa va mahsulot taqdimoti",
  "templateId": "BUSINESS",
  "scenarioId": null,
  "firstMessage": "Assalomu alaykum! Men kompaniya AI maslahatchisiman. Sizga qanday yordam bera olaman?",
  "systemPrompt": "Siz kompaniyaning tajribali savdo maslahatchisisiz. Savollarga qisqa, aniq va do'stona javob bering.",
  "preemptiveGeneration": true,
  "ivrNavigationEnabled": true,
  "useRag": false,
  "language": "uz-UZ",
  "sttProvider": "yandex",
  "sttModel": "general",
  "ttsProvider": "yandex",
  "ttsModel": null,
  "ttsVoice": "nigora",
  "voiceSpeed": 1.0,
  "voiceStability": 0.75,
  "voiceSimilarityBoost": 0.85,
  "languageVoices": {
    "uz-UZ": "nigora",
    "ru-RU": "alena"
  },
  "persona": "AI_ASSISTANT",
  "llmModel": "gemini-3.8-flash",
  "fastLlmModel": "gemini-3.5-flash-lite",
  "temperature": 0.7,
  "maxOutputTokens": 250,
  "dataNeeded": [
    {
      "id": "client_name",
      "type": "string",
      "name": "Mijoz ismi",
      "description": "Mijozning to'liq ismi"
    },
    {
      "id": "interest_level",
      "type": "string",
      "name": "Qiziqish darajasi",
      "description": "HIGH, MEDIUM yoki LOW"
    }
  ],
  "dataEvaluation": [
    {
      "id": "call_goal_achieved",
      "name": "Maqsadga erishildi",
      "scale": "boolean",
      "criteria": "Mijoz talabi aniqlandimi"
    },
    {
      "id": "politeness",
      "name": "Xushmuomalalik",
      "scale": "1-5",
      "criteria": "Agent va mijoz muloqot ohangi"
    }
  ],
  "zeroPiiRetention": false,
  "storeCallAudio": true,
  "conversationRetentionDays": 90,
  "maxConversationDurationSeconds": 600,
  "silenceEndCallTimeoutSeconds": 25,
  "turnTimeoutSeconds": 15,
  "concurrentCallsLimit": 10,
  "dailyCallsLimit": 1000,
  "initiationWebhook": {
    "url": "https://webhook.site/test-start",
    "headers": { "Authorization": "Bearer secret" },
    "timeoutSeconds": 5
  },
  "postCallWebhook": {
    "url": "https://webhook.site/test-end",
    "headers": { "Authorization": "Bearer secret" },
    "timeoutSeconds": 10
  },
  "ambientSound": "OFFICE",
  "ambientSoundVolume": 1.0,
  "ambientSoundFadeInSeconds": 1.5,
  "thinkingSound": "KEYBOARD_TYPING",
  "thinkingSoundVolume": 0.30,
  "noiseCancellationEnabled": true,
  "noiseCancellationMode": "BACKGROUND_NOISE_SUPPRESSION",
  "emotionAdaptiveVoice": true,
  "dtmfInputEnabled": true,
  "voicemailAction": "LEAVE_MESSAGE",
  "voicemailMessage": "Assalomu alaykum, siz bilan bog'lana olmadik. Iltimos qaytib qo'ng'iroq qiling.",
  "midCallSmsEnabled": false,
  "midCallSmsTemplate": null,
  "sipTrunkIds": [1],
  "enabled": true
}

### 3. Filter AI Agents
POST http://localhost:8080/api/ai-agents/filter
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "page": 0,
  "size": 20,
  "orders": { "CREATED_AT": "DESC" },
  "search": "savdo",
  "enabled": true
}

### 4. Get AI Agent by ID
GET http://localhost:8080/api/ai-agents/1
Authorization: Bearer {{auth_token}}

### 5. Update AI Agent
PUT http://localhost:8080/api/ai-agents/1
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Savdo maslahatchisi (Yangilangan)",
  "templateId": "BUSINESS",
  "firstMessage": "Xayrli kun! Sizga qanday yordam bera olaman?",
  "systemPrompt": "Siz kompaniyaning eng tajribali xodimlaridansiz.",
  "preemptiveGeneration": true,
  "language": "uz-UZ",
  "ttsVoice": "nigora",
  "persona": "HUMAN_LIKE",
  "llmModel": "gemini-3.8-flash",
  "fastLlmModel": "gemini-3.5-flash-lite",
  "temperature": 0.6,
  "maxOutputTokens": 300,
  "enabled": true
}

### 6. Delete AI Agent (409 while a campaign or inbound route still uses it)
DELETE http://localhost:8080/api/ai-agents/1
Authorization: Bearer {{auth_token}}

### 6.1. Get Agent Scenario & Behavior (Embedded Scenario)
GET http://localhost:8080/api/ai-agents/1/scenario
Authorization: Bearer {{auth_token}}

### 6.2. Update Agent Scenario & Behavior (PROMPT or STRUCTURED_STEPS)
PUT http://localhost:8080/api/ai-agents/1/scenario
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "scenarioMode": "PROMPT",
  "firstMessage": "Assalomu alaykum! Sizga qanday yordam bera olaman?",
  "systemPrompt": "Siz kompaniyaning sun'iy intellekt konsultantisiz. Mijoz bilan muloyim so'zlashib, mahsulotlar bo'yicha maslahat bering.",
  "stages": [
    {
      "id": "GREETING",
      "purpose": "Mijoz bilan salomlashish va ehtiyojini aniqlash",
      "allowedTransitions": ["OFFER", "SUPPORT"],
      "allowedTools": []
    }
  ],
  "guardrails": [
    "Kompaniya ruxsat bermagan chegirmalarni va'da qilmang",
    "Boshqa mijozlar ma'lumotlarini oshkor qilmang"
  ],
  "factSchema": [
    {
      "name": "client_name",
      "type": "STRING",
      "description": "Mijoz ismi"
    }
  ],
  "disclosureText": "Ushbu suhbat yozib olinadi."
}

### 7. Get Agent Analysis Configuration (data_needed & data_evaluation)
GET http://localhost:8080/api/ai-agents/1/analysis
Authorization: Bearer {{auth_token}}

### 8. Update Agent Analysis Configuration
PUT http://localhost:8080/api/ai-agents/1/analysis
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "dataNeeded": [
    {
      "id": "order_id",
      "type": "string",
      "name": "Buyurtma ID",
      "description": "Mijozning 6 xonali buyurtma raqami"
    },
    {
      "id": "delivery_time",
      "type": "string",
      "name": "Yetkazish vaqti",
      "description": "Yetkazish uchun qulay vaqt"
    }
  ],
  "dataEvaluation": [
    {
      "id": "order_confirmed",
      "name": "Buyurtma tasdiqlandi",
      "criteria": "Mijoz buyurtma berishga rozi bo'ldimi"
    },
    {
      "id": "call_politeness",
      "name": "Xushmuomalalik",
      "criteria": "Agent va mijoz ohangi muloyim bo'ldimi"
    }
  ]
}

### 9. Get Agent Attached Tools
GET http://localhost:8080/api/ai-agents/1/tools
Authorization: Bearer {{auth_token}}

### 10. Attach Tool to Agent
POST http://localhost:8080/api/ai-agents/1/tools/1
Authorization: Bearer {{auth_token}}

### 11. Detach Tool from Agent
DELETE http://localhost:8080/api/ai-agents/1/tools/1
Authorization: Bearer {{auth_token}}

### 12. Get Agent Limits
GET http://localhost:8080/api/ai-agents/1/limits
Authorization: Bearer {{auth_token}}

### 13. Update Agent Limits
PUT http://localhost:8080/api/ai-agents/1/limits
