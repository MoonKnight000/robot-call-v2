HELP.md
.env
recordings/
# SIP trunk credentials (secret) — included by pjsip.conf
asterisk/etc/asterisk/pjsip_auth.conf
# ARI / AMI / softphone / web-test credentials — generated from .env by
# asterisk/render-auth.sh, included by ari.conf, manager.conf and pjsip.conf
asterisk/etc/asterisk/ari_auth.conf
asterisk/etc/asterisk/manager_auth.conf
asterisk/etc/asterisk/pjsip_local_auth.conf
# Generated PJSIP config — managed SIP trunks (PjsipConfigWriter, report #7) and operator
# endpoints (PjsipOperatorEndpointConfigAdapter). Plaintext passwords (PJSIP requires it),
# never committed. The directory itself is kept so the app's bind mount has a source.
asterisk/etc/asterisk/generated/*
!asterisk/etc/asterisk/generated/.gitkeep
# Which cells of a cluster talk to each other — hosts of this deployment (pjsip_cells.conf.example).
asterisk/etc/asterisk/pjsip_cells.conf
# Cloud credentials — Google STT/TTS read them via GOOGLE_APPLICATION_CREDENTIALS
# (a path outside the repo), so a key file must never live here.
**/credential/
**/credentials/
*-service-account*.json
gcp*.json
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

