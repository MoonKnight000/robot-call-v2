# Copy to .env and adjust. Used by docker-compose and the Spring services.
# --- PostgreSQL ---
DB_NAME=uysot_voice
DB_USER=uysot
DB_PASSWORD=uysot
DB_URL=jdbc:postgresql://localhost:5432/uysot_voice

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=uysot
RABBITMQ_PASSWORD=uysot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_USER=uysot
MINIO_PASSWORD=uysot-secret

# --- Asterisk / ARI ---
# Must match asterisk/etc/asterisk/ari.conf [uysot] password.
ARI_USER=uysot
ARI_PASSWORD=CHANGE_ME_ARI_PASSWORD
# Outbound routing. Numbers matching LOCAL_NUMBER_PATTERN (3-4 digits) ring the
# registered test softphone; anything longer goes out over the trunk. Leave
# LOCAL_ENDPOINT empty to send everything to the trunk.
# TRUNK_ENDPOINT=trunk-endpoint
# LOCAL_ENDPOINT=softphone

# --- Docker on Windows/Mac ---
# When running the app via `docker compose up` (recommended on Windows), the app
# runs in the same network as Asterisk and RTP_LOCAL_IP is set to `app` for you.
# Only needed if you enable the Google creds mount in docker-compose.yml:
GOOGLE_CREDS_PATH=./gcp.json

# --- Google Cloud (STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=google ---
# Path to a service-account JSON with Speech + Text-to-Speech access (local run).
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Surface PC\IdeaProjects\robot-call-v2\src\main\resources\credential\celestial-smile-289510-6b5c30832ef4.json

# --- STT / TTS provider selection (default: Yandex) ---
# yandex or google. SpeechKit handles uz-UZ (Latin) and ru-RU for both STT and TTS.
STT_PROVIDER=yandex
TTS_PROVIDER=yandex

# --- Yandex SpeechKit (shared account for STT + TTS) ---
# STT (v3 streaming gRPC):
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
# TTS (v1 synthesize). Voice names are lowercase and language-specific:
#   TTS_YANDEX_VOICE    — default, used for ru-RU (alena, filipp, jane, omazh, zahar, ...)
#   TTS_YANDEX_VOICE_UZ — uz-UZ voice (nigora)
TTS_YANDEX_ENABLED=true
TTS_YANDEX_API_KEY=
TTS_YANDEX_FOLDER_ID=
TTS_YANDEX_VOICE=alena
TTS_YANDEX_VOICE_UZ=nigora

# --- LLM dialog (Gemini via OpenAI-compatible proxy, Spring AI) ---
# Required for the conversation engine. Without it the app still runs; dialog is off.
# GEMINI_API_KEY: the key your proxy expects. GEMINI_API_BASE_URL: the proxy's
# OpenAI-compatible base URL (Spring AI appends /v1/chat/completions).
GEMINI_API_KEY=
GEMINI_API_BASE_URL=
# Fast model for the live conversation. Summary (Stage 9) uses a stronger model.
# Use whatever model IDs your proxy exposes — a LiteLLM gateway wants the provider
# prefix ("gemini/gemini-2.5-flash"); check with GET {GEMINI_API_BASE_URL}/v1/models.
LLM_DIALOG_MODEL=gemini/gemini-2.5-flash
SUMMARY_MODEL=gemini/gemini-2.5-pro

# --- VAD / barge-in (Silero) ---
# Path to silero_vad.onnx. Blank = barge-in disabled (bot can't be interrupted).
VAD_MODEL_PATH=/path/to/silero_vad.onnx

# --- Call recording storage (MinIO) ---
# Off by default; set true to upload finished recordings.
STORAGE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=recordings

# --- CRM write-back (Uysot) ---
# Off until configured; posts the call summary as a note.
CRM_ENABLED=false
CRM_BASE_URL=
CRM_API_TOKEN=

# --- Operator transfer (§11.6) ---
# Endpoint to ring on transfer: a direct agent (PJSIP/operator) or the queue
# (Local/support@operators). Add real agents to asterisk/etc/asterisk/queues.conf.
OPERATOR_ENABLED=true
OPERATOR_ENDPOINT=Local/support@operators
