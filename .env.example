# Copy to .env and adjust. Used by docker-compose and the Spring services.
# Details for every setting live next to it in src/main/resources/config/*.yml
# (or docker-compose.yml for the Docker-only ones below).

# --- API access ---
SECURITY_PUBLIC_UI=true

# --- User login ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRY_MINUTES=720
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- PostgreSQL ---
DB_NAME=robot_call
DB_USER=robot_call
DB_PASSWORD=robot_call
DB_URL=jdbc:postgresql://localhost:5432/robot_call

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=robot_call
RABBITMQ_PASSWORD=robot_call

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_USER=robot_call
MINIO_PASSWORD=robot_call

# --- Asterisk / ARI ---
ARI_USER=robot_call
ARI_PASSWORD=CHANGE_ME_ARI_PASSWORD
# ARI_LOG_LEVEL=ERROR
# TRUNK_ENDPOINT=trunk-endpoint
# LOCAL_ENDPOINT=softphone
# A-number shown to the callee. Must be a real DID the SIP account owns, E.164 without
# "+" (998XXXXXXXXX). Blank: PJSIP sends the trunk login instead, which is what a callee
# sees as "+781137492". A number the account does not own is answered 603 Declined.
# CALLER_ID=998712001122

# --- Docker on Windows/Mac ---
GOOGLE_CREDS_PATH=./gcp.json

# --- Google Cloud (STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=google ---
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Surface PC\IdeaProjects\robot-call-v2\src\main\resources\credential\celestial-smile-289510-6b5c30832ef4.json

# --- STT / TTS provider defaults ---
STT_PROVIDER=yandex
TTS_PROVIDER=yandex

# --- Realtime (speech-to-speech) engines ---
# Global master switch for Realtime engines:
REALTIME_ENABLED=true
# Har bir kompaniya qaysi realtime provayderni ishlatishini o'zining sozlamalarida
# (Company Engine Config -> realtimeProvider: gemini-live, pipecat, openai-realtime, qwen-omni, moshi)
# mustaqil tanlaydi. YML'da qat'iy provayder belgilanmagan.
# Ixtiyoriy global fallback provayder:
# REALTIME_PROVIDER=

# Provayderlarning AI modellari:
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
# OpenAI Realtime uchun kalit — yuqoridagi OPENAI_API_KEY dan olinadi.
# REALTIME_OPENAI_MODEL=gpt-realtime-2.1
# REALTIME_FACTS_IN_PROMPT=true
# Pipecat Cloud & Anthropic Claude Realtime:
# REALTIME_PROVIDER=pipecat
# PIPECAT_CLOUD_API_KEY=pcc_...
# REALTIME_PIPECAT_AGENT=phone-agent
# ANTHROPIC_API_KEY=sk-ant-...
# REALTIME_PIPECAT_WS_URL=wss://...

# --- Yandex SpeechKit (shared account for STT + TTS) ---
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
STT_YANDEX_EOU_SENSITIVITY=DEFAULT
STT_YANDEX_EOU_MAX_PAUSE_MS=0
STT_YANDEX_KEEPALIVE_SECONDS=60
# Replace an STT stream that swallows audio for this long without one transcript (0 = off)
STT_RESPONSE_TIMEOUT_MS=30000
TTS_YANDEX_KEEPALIVE_SECONDS=60
TTS_YANDEX_ENABLED=true
TTS_YANDEX_API_KEY=
TTS_YANDEX_FOLDER_ID=
TTS_YANDEX_VOICE=alena
TTS_YANDEX_VOICE_UZ=nigora

# --- Aisha (realtime WebSocket STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=aisha ---
STT_AISHA_API_KEY=
TTS_AISHA_API_KEY=
TTS_AISHA_SPEAKER=neutral
# DIALOG_TTS_VOICE=nigora

# --- LLM dialog (Google Gemini or OpenAI) ---
# Set the key for whichever provider LLM_CHAT_PROVIDER names. OPENAI_API_KEY is also what
# the OpenAI Realtime engine authenticates with, so one key covers both pipelines.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provider selection: google-genai | openai
# LLM_CHAT_PROVIDER=openai
# Model name — must be one of the ids in the ai_model catalog for that provider:
#   Gemini: gemini-3.8-flash, gemini-3.5-flash-lite
#   OpenAI: gpt-5.6-luna (arzon, tezkor), gpt-5.6-terra, gpt-5.6-sol, gpt-6-astra,
#           gpt-5.5, gpt-5.4-mini (oldingi avlod)
LLM_DIALOG_MODEL=gemini-3.8-flash
SUMMARY_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=minimal
# Any OpenAI-compatible endpoint can take the openai slot, but then the catalog's OpenAI
# ids no longer match what the URL serves — seed that vendor's ids before switching.
# OPENAI_BASE_URL=https://api.openai.com

# OPENAI_API_KEY above also enables the OpenAI STT and TTS providers (sttProvider=openai /
# ttsProvider=openai) and the OpenAI Realtime engine. Defaults are usually right:
# STT_OPENAI_MODEL=gpt-live-transcribe     # gpt-transcribe: aniqroq, lekin oraliq natija yo'q
# STT_OPENAI_SAMPLE_RATE=24000
# TTS_OPENAI_MODEL=gpt-4o-mini-tts
# TTS_OPENAI_VOICE=alloy
# Uslub ko'rsatmasi — har bir gapga qo'llanadi (masalan: "Speak calmly and politely")
# TTS_OPENAI_INSTRUCTIONS=

# Deepgram STT — kalit qo'yilsa provayder yoqiladi va nova-3 katalogda ko'rinadi.
STT_DEEPGRAM_API_KEY=

# --- VAD / barge-in (Silero) ---
# VAD_MODEL_PATH=/path/to/silero_vad.onnx
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=350
# VAD_AMD_ENABLED=true
# VAD_AMD_MIN_SPEECH_MS=3500

# --- Cost controls (all optional; the defaults below are already in effect) ---
# STT_VAD_GATING=true
# STT_VAD_PRE_ROLL_MS=500
# STT_VAD_POST_ROLL_MS=800
# STT_VAD_MIN_SPEECH_MS=120
# STT_ENDPOINTING=true
# STT_ENDPOINTING_SHORT_UTTERANCE_MS=1200
# STT_ENDPOINTING_SHORT_SILENCE_MS=400
# STT_ENDPOINTING_MAX_UTTERANCE_MS=20000
# STT_ENDPOINTING_DYNAMIC=false
# STT_ENDPOINTING_DYNAMIC_MIN_POST_ROLL_MS=600
# STT_ENDPOINTING_DYNAMIC_EMA_ALPHA=0.2
# STT_ENDPOINTING_DYNAMIC_REOPEN_GRACE_MS=900
# TURN_DETECTOR=false
# TURN_MODEL_PATH=/models/smart_turn_v3.onnx
# TURN_LANGUAGES=ru-RU
# TURN_THRESHOLD=0.5
# TURN_MAX_EXTEND_MS=800
# TURN_N_FFT=512
# TURN_HOP_SAMPLES=256
# TURN_MELS=128
# TURN_FRAMES=500
# TTS_CACHE_REDIS=true
# TTS_CACHE_PREWARM=false
# TTS_CACHE_TTL_DAYS=30
# TTS_CACHE_SIZE=200
# DIALOG_STATE_SCOPED_TOOLS=true
# DIALOG_HISTORY_MAX_MESSAGES=40
# DIALOG_GREETING_DELAY_MS=1200
# DIALOG_FILLER_DELAY_MS=350
# DIALOG_FALSE_INTERRUPTION_TIMEOUT_MS=1500
# DIALOG_MIN_INTERRUPTION_WORDS=2
# DIALOG_PREEMPTIVE=false
# DIALOG_PREEMPTIVE_MIN_CHARS=12
# DIALOG_MAX_TOKENS_PER_CALL=200000

# --- Silence watchdog and guardrails ---
# DIALOG_NO_INPUT_SECONDS=9
# DIALOG_NO_INPUT_MAX_PROMPTS=2
# DIALOG_FACT_GUARD=true
# DIALOG_FACT_VIOLATION_ESCALATE_AFTER=1
# VAD_AMD_ENABLED=true
# VAD_AMD_OBSERVE_MS=6000
# VAD_AMD_MIN_SPEECH_MS=3500

# --- File storage (MinIO) ---
STORAGE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=files

# --- CRM (Uysot Open API v1) ---
CRM_ENABLED=false
# Prod is https://api.service.app.uysot.uz — point this at the dev host to try a call
# against test data without writing notes onto real leads.
CRM_BASE_URL=
# Only the fallback for a company that has not connected through Settings > Integrations.
# Once the OAuth flow below has run, that company's stored token is used instead.
CRM_API_TOKEN=
# The Uysot employee AI calls are filed under (POST /v1/open-api/employee/filter → id).
# Leave blank to switch call-history write-back off; the lead note still works.
# CRM_CALL_HISTORY_EMPLOYEE_ID=
# Endpoint paths — override only if Uysot moves one.
# CRM_LEAD_PATH=v1/open-api/lead/{id}
# CRM_LEAD_FILTER_PATH=v1/open-api/lead/filter
# CRM_LEAD_NOTE_PATH=v1/open-api/lead-note/{id}/list
# CRM_CONTRACT_PATH=v1/open-api/contract/{id}
# CRM_CONTRACT_FILTER_PATH=v1/open-api/contract/filter
# How many debtors the daily campaign pulls per run (the API allows 60 requests/minute
# and one debtor costs three).
# CRM_DEBTOR_MIN_DELAY_DAYS=1
# CRM_DEBTOR_MAX=200
# OUTBOX_ENABLED=true
# OUTBOX_INTERVAL_MINUTES=5
# OUTBOX_MAX_ATTEMPTS=5

# --- Uysot CRM OAuth integration (§11 settings) ---
# The consent page's host is handed out at application registration — the dev app and the
# production one do not share it.
# UYSOT_OAUTH_AUTHORIZE_URL=https://crm.uysot.uz/oauth/authorize
# UYSOT_OAUTH_TOKEN_URL=https://service.app.uysot.uz/v1/open-api/oauth/token
# Where Uysot sends the browser back with ?code=&state=. Must be registered on the Uysot
# application character for character, and must be this backend — the token exchange needs
# the client secret, so the code must not land on a page.
# UYSOT_OAUTH_REDIRECT_URI=https://your-domain/api/settings/integrations/uysot/callback
# Where the browser is sent afterwards, with ?crm=connected or ?crm=error&reason=<ErrorCode>.
# UYSOT_OAUTH_CALLBACK_REDIRECT_URL=http://localhost:5173/settings/integrations
# From the Uysot application: uysot_app_… and uysot_sec_… . The secret never leaves the
# backend — keep it out of the frontend build and out of version control.
# UYSOT_OAUTH_CLIENT_ID=
# UYSOT_OAUTH_CLIENT_SECRET=
# Required before any token can be stored: the tokens are encrypted at rest with this key.
# ENCRYPTION_SECRET_KEY=

# --- Notifications (§11 settings) ---
# TELEGRAM_BOT_TOKEN=

# --- Operator transfer (§11.6) ---
OPERATOR_ENABLED=true
OPERATOR_ENDPOINT=Local/support@operators
