# Copy to .env and adjust. Used by docker-compose and the Spring services.
# Details for every setting live next to it in src/main/resources/config/*.yml
# (or docker-compose.yml for the Docker-only ones below).

# --- API access ---
API_KEY=CHANGE_ME_API_KEY
# READ_API_KEY=CHANGE_ME_READ_ONLY_KEY
# SECURITY_PUBLIC_UI=true

# --- User login ---
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRY_MINUTES=720
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- PostgreSQL ---
DB_NAME=uysot_voice
DB_USER=uysot
DB_PASSWORD=uysot
DB_URL=jdbc:postgresql://localhost:5432/uysot_voice

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=uysot
RABBITMQ_PASSWORD=uysot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_USER=uysot
MINIO_PASSWORD=uysot-secret

# --- Asterisk / ARI ---
ARI_USER=uysot
ARI_PASSWORD=CHANGE_ME_ARI_PASSWORD
# ARI_LOG_LEVEL=ERROR
# TRUNK_ENDPOINT=trunk-endpoint
# LOCAL_ENDPOINT=softphone

# --- Docker on Windows/Mac ---
GOOGLE_CREDS_PATH=./gcp.json

# --- Google Cloud (STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=google ---
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Surface PC\IdeaProjects\robot-call-v2\src\main\resources\credential\celestial-smile-289510-6b5c30832ef4.json

# --- STT / TTS provider defaults ---
STT_PROVIDER=yandex
TTS_PROVIDER=yandex

# --- Realtime (speech-to-speech) engines ---
REALTIME_ENABLED=true
REALTIME_PROVIDER=gemini-live
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
# REALTIME_FACTS_IN_PROMPT=false

# --- Yandex SpeechKit (shared account for STT + TTS) ---
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
STT_YANDEX_EOU_SENSITIVITY=DEFAULT
STT_YANDEX_EOU_MAX_PAUSE_MS=0
STT_YANDEX_KEEPALIVE_SECONDS=60
TTS_YANDEX_KEEPALIVE_SECONDS=60
TTS_YANDEX_ENABLED=true
TTS_YANDEX_API_KEY=
TTS_YANDEX_FOLDER_ID=
TTS_YANDEX_VOICE=alena
TTS_YANDEX_VOICE_UZ=nigora

# --- Aisha (realtime WebSocket STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=aisha ---
STT_AISHA_API_KEY=
TTS_AISHA_API_KEY=
TTS_AISHA_SPEAKER=neutral
# DIALOG_TTS_VOICE=nigora

# --- LLM dialog (Gemini direct, via Google's OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
# LLM_CHAT_PROVIDER=google-genai
LLM_DIALOG_MODEL=gemini-3.7-flash
SUMMARY_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=minimal

# --- VAD / barge-in (Silero) ---
# VAD_MODEL_PATH=/path/to/silero_vad.onnx
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=350
# VAD_AMD_ENABLED=true
# VAD_AMD_MIN_SPEECH_MS=3500

# --- Cost controls (all optional; the defaults below are already in effect) ---
# STT_VAD_GATING=true
# STT_VAD_PRE_ROLL_MS=500
# STT_VAD_POST_ROLL_MS=800
# STT_VAD_MIN_SPEECH_MS=120
# STT_ENDPOINTING=true
# STT_ENDPOINTING_SHORT_UTTERANCE_MS=1200
# STT_ENDPOINTING_SHORT_SILENCE_MS=400
# STT_ENDPOINTING_MAX_UTTERANCE_MS=20000
# STT_ENDPOINTING_DYNAMIC=false
# STT_ENDPOINTING_DYNAMIC_MIN_POST_ROLL_MS=600
# STT_ENDPOINTING_DYNAMIC_EMA_ALPHA=0.2
# STT_ENDPOINTING_DYNAMIC_REOPEN_GRACE_MS=900
# TURN_DETECTOR=false
# TURN_MODEL_PATH=/models/smart_turn_v3.onnx
# TURN_LANGUAGES=ru-RU
# TURN_THRESHOLD=0.5
# TURN_MAX_EXTEND_MS=800
# TURN_N_FFT=512
# TURN_HOP_SAMPLES=256
# TURN_MELS=128
# TURN_FRAMES=500
# TTS_CACHE_REDIS=true
# TTS_CACHE_PREWARM=true
# TTS_CACHE_TTL_DAYS=30
# TTS_CACHE_SIZE=200
# DIALOG_STATE_SCOPED_TOOLS=true
# DIALOG_HISTORY_MAX_MESSAGES=40
# DIALOG_GREETING_DELAY_MS=1200
# DIALOG_FILLER_DELAY_MS=350
# DIALOG_FALSE_INTERRUPTION_TIMEOUT_MS=1500
# DIALOG_MIN_INTERRUPTION_WORDS=2
# DIALOG_PREEMPTIVE=false
# DIALOG_PREEMPTIVE_MIN_CHARS=12
# DIALOG_MAX_TOKENS_PER_CALL=200000

# --- Silence watchdog and guardrails ---
# DIALOG_NO_INPUT_SECONDS=9
# DIALOG_NO_INPUT_MAX_PROMPTS=2
# DIALOG_FACT_GUARD=true
# DIALOG_FACT_VIOLATION_ESCALATE_AFTER=1
# VAD_AMD_ENABLED=true
# VAD_AMD_OBSERVE_MS=6000
# VAD_AMD_MIN_SPEECH_MS=3500

# --- File storage (MinIO) ---
STORAGE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=files

# --- CRM (Uysot) ---
CRM_ENABLED=false
CRM_BASE_URL=
CRM_API_TOKEN=
# CRM_CLIENT_PATH=api/clients/{id}
# OUTBOX_ENABLED=true
# OUTBOX_INTERVAL_MINUTES=5
# OUTBOX_MAX_ATTEMPTS=5

# --- Uysot CRM OAuth integration (§11 settings) ---
# UYSOT_OAUTH_AUTHORIZE_URL=
# UYSOT_OAUTH_TOKEN_URL=
# UYSOT_OAUTH_REDIRECT_URI=https://your-domain/api/settings/integrations/uysot/callback
# ENCRYPTION_SECRET_KEY=

# --- Notifications (§11 settings) ---
# TELEGRAM_BOT_TOKEN=

# --- Operator transfer (§11.6) ---
OPERATOR_ENABLED=true
OPERATOR_ENDPOINT=Local/support@operators
