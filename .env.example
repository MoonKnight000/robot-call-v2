# Copy to .env and adjust. Used by docker-compose and the Spring services.

# --- API access (REQUIRED) ---
# Shared secret sent as the X-Api-Key header on every /api/** and /actuator/** call.
# Without it the app starts but answers 401 to everything — POST /api/calls dials the
# real trunk, so it is never open by default. Generate one, e.g.:
#   openssl rand -hex 32
API_KEY=CHANGE_ME_API_KEY
# Optional SECOND key that may only read: /api/reports/** and /actuator/**. Reporting,
# transcripts and recordings are what most people need day to day; give them this instead
# of the key that can dial every debtor on the list. Must differ from API_KEY.
# READ_API_KEY=CHANGE_ME_READ_ONLY_KEY
# Set false to also require the key for the static test panel and swagger-ui.
# SECURITY_PUBLIC_UI=true

# --- User login (ROADMAP E.1, REQUIRED for the panel — X-Api-Key above is unaffected) ---
# HS256 signing key for Authorization: Bearer tokens. Blank = nobody can log in. Generate
# one the same way as API_KEY; any non-blank value works (it's hashed to 256 bits).
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Access token lifetime in minutes. No server-side revocation — logout is client-side.
JWT_EXPIRY_MINUTES=720
# First admin account, seeded once on startup if nobody has ever logged in yet — without
# this, there is no way to create the rest of the users through the API.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- PostgreSQL ---
DB_NAME=uysot_voice
DB_USER=uysot
DB_PASSWORD=uysot
DB_URL=jdbc:postgresql://localhost:5432/uysot_voice

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=uysot
RABBITMQ_PASSWORD=uysot

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO ---
MINIO_USER=uysot
MINIO_PASSWORD=uysot-secret

# --- Asterisk / ARI ---
# Must match asterisk/etc/asterisk/ari.conf [uysot] password.
ARI_USER=uysot
ARI_PASSWORD=CHANGE_ME_ARI_PASSWORD
# Outbound routing. Numbers matching LOCAL_NUMBER_PATTERN (3-4 digits) ring the
# registered test softphone; anything longer goes out over the trunk. Leave
# LOCAL_ENDPOINT empty to send everything to the trunk.
# TRUNK_ENDPOINT=trunk-endpoint
# LOCAL_ENDPOINT=softphone

# --- Docker on Windows/Mac ---
# When running the app via `docker compose up` (recommended on Windows), the app
# runs in the same network as Asterisk and RTP_LOCAL_IP is set to `app` for you.
# Only needed if you enable the Google creds mount in docker-compose.yml:
GOOGLE_CREDS_PATH=./gcp.json

# --- Google Cloud (STT + TTS) — only if STT_PROVIDER/TTS_PROVIDER=google ---
# Path to a service-account JSON with Speech + Text-to-Speech access (local run).
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\Surface PC\IdeaProjects\robot-call-v2\src\main\resources\credential\celestial-smile-289510-6b5c30832ef4.json

# --- STT / TTS provider selection (default: Yandex) ---
# yandex or google. SpeechKit handles uz-UZ (Latin) and ru-RU for both STT and TTS.
STT_PROVIDER=yandex
TTS_PROVIDER=yandex

# --- Yandex SpeechKit (shared account for STT + TTS) ---
# STT (v3 streaming gRPC):
STT_YANDEX_API_KEY=
STT_YANDEX_FOLDER_ID=
# TTS (v1 synthesize). Voice names are lowercase and language-specific:
#   TTS_YANDEX_VOICE    — default, used for ru-RU (alena, filipp, jane, omazh, zahar, ...)
#   TTS_YANDEX_VOICE_UZ — uz-UZ voice (nigora)
TTS_YANDEX_ENABLED=true
TTS_YANDEX_API_KEY=
TTS_YANDEX_FOLDER_ID=
TTS_YANDEX_VOICE=alena
TTS_YANDEX_VOICE_UZ=nigora
# The two settings above are the fallback routing. A campaign can instead pick a voice
# when it is created (GET /api/tts/voices lists them); the list itself lives in the
# tts_voice table (migration V3), not here.
# Voice for manual/auto-started calls — a catalog id, blank = the routing above.
# DIALOG_TTS_VOICE=nigora

# --- LLM dialog (Gemini direct, via Google's OpenAI-compatible endpoint) ---
# Only the key is required for the conversation engine. Without it the app still
# runs; dialog is off. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The endpoint is built by the native Google GenAI client, so there is no base URL or
# completions path to configure.
# Which chat provider Spring AI activates. "none" disables the LLM entirely — use it for
# a deploy without a key, because google-genai + a blank key fails at startup
# ("API key must either be provided or set in the environment variable ...").
# LLM_CHAT_PROVIDER=google-genai
# Plain Gemini ids — no "gemini/" prefix (that was only for the LiteLLM gateway).
# NOTE: the pro models are quota 0 on a free Gemini key (429 on every call), so the
# summary runs on flash too. Use a pro model once your key is on billing.
# NOTE: gemini-2.5-* 404s for keys that never used it ("no longer available to new
# users"). List what your key may actually use with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
LLM_DIALOG_MODEL=gemini-3.6-flash
SUMMARY_MODEL=gemini-3.6-flash
# Thinking budget for the dialog. Gemini 3.x rejects "none" with 400 INVALID_ARGUMENT
# and spells the same zero-thinking budget "minimal" — and a failed turn is spoken to
# the caller as "Uzr, sizni eshitolmadim". Raise to low/medium/high only if needed.
LLM_REASONING_EFFORT=minimal

# --- VAD / barge-in (Silero) ---
# Path to silero_vad.onnx. Blank = barge-in disabled (bot can't be interrupted).
VAD_MODEL_PATH=/path/to/silero_vad.onnx

# --- Cost controls (all optional; the defaults below are already in effect) ---
# STT is billed per streamed audio-second, so the VAD decides what reaches the
# recognizer instead of streaming the whole call. Needs VAD_MODEL_PATH set; without a
# model every frame is streamed as before. Watch voice.stt.audio.seconds.{sent,skipped}.
# If finals stop arriving (the turn hangs), raise the post-roll or set this to false.
# STT_VAD_GATING=true
# STT_VAD_PRE_ROLL_MS=500
# STT_VAD_POST_ROLL_MS=1500
#
# TTS is billed per character. Fixed lines (disclosure, farewell, "say that again") are
# synthesized once at startup and shared through Redis, so a restart or a second
# instance does not re-buy them. Watch voice.tts.chars.{synthesized,saved}.
# TTS_CACHE_REDIS=true
# TTS_CACHE_PREWARM=true
# TTS_CACHE_TTL_DAYS=30
# TTS_CACHE_SIZE=200
#
# LLM: only the tools the current dialog state can use are sent each turn, and the
# request keeps a stable prefix so Gemini can serve most of it from its context cache.
# voice.llm.tokens.cached is how you tell caching is working; if it stays at zero the
# prefix is being broken somewhere. Set false to send every tool on every turn.
# DIALOG_STATE_SCOPED_TOOLS=true
# DIALOG_HISTORY_MAX_MESSAGES=40
#
# Milliseconds to wait after the call is answered before speaking. The far end reports
# "answered" when it sends the 200 OK, but the handset needs longer to open its audio
# path — and the person is still raising it. Without the pause the greeting starts too
# early and the caller only catches the tail ("...alaykum"). Raise it for mobile/GSM
# routes; lower it if the opening silence feels dead.
# DIALOG_GREETING_DELAY_MS=1200
#
# Per-call token budget: a call that loops resends its whole context every turn, so the
# turn cap alone does not bound the bill. Exceeding it ends the call politely. 0 = off.
# DIALOG_MAX_TOKENS_PER_CALL=200000

# --- Silence watchdog and guardrails ---
# A turn only happens when the recognizer emits a final transcript, so a caller who says
# nothing left the line mute until DIALOG_MAX_CALL_SECONDS. After this many quiet seconds
# the bot asks "alo, meni eshityapsizmi?"; after DIALOG_NO_INPUT_MAX_PROMPTS unanswered
# asks it says goodbye and hangs up. Watch voice.dialog.no.input.{prompts,hangups}.
# DIALOG_NO_INPUT_SECONDS=9
# DIALOG_NO_INPUT_MAX_PROMPTS=2
#
# §4.4 fact guard: money figures in the model's reply are checked against the injected
# facts before being spoken. A hallucinated debt amount is the worst output this system
# has — the caller hears a demand for money they do not owe, on a recorded line. A blocked
# reply is retried once with the mistake named, then escalated to a human.
# voice.dialog.fact.guard.blocks should be zero; alert on it, do not just watch it.
# DIALOG_FACT_GUARD=true
#
# Answering-machine detection (§8.6): one continuous run of speech longer than
# VAD_AMD_MIN_SPEECH_MS inside the first VAD_AMD_OBSERVE_MS means a recording answered —
# the call is marked VOICEMAIL, cut off, and retried at a different hour. Needs VAD.
# The threshold is deliberately generous: cutting off a talkative human is far worse than
# paying for one wasted voicemail, so tune it DOWN only against real recordings.
# VAD_AMD_ENABLED=true
# VAD_AMD_OBSERVE_MS=6000
# VAD_AMD_MIN_SPEECH_MS=3500

# --- File storage (MinIO) ---
# Off by default; set true to upload call recordings / company logos / user avatars.
# One shared bucket — object keys are namespaced per company/category (see
# FileStorageService), and every file is served back through GET /api/files/{id},
# never a raw MinIO URL.
STORAGE_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=files

# --- CRM (Uysot) ---
# Off until configured. Posts the call summary as a note, and reads the client back before
# dialling so the debt figure the agent states is current and preferred_language is honoured
# (§3.1). {id} is the client id. A failed lookup never blocks the call.
CRM_ENABLED=false
CRM_BASE_URL=
CRM_API_TOKEN=
# CRM_CLIENT_PATH=api/clients/{id}
#
# A CRM outage used to lose the note permanently — for a call whose whole point is the CRM
# note, that loses the call. The outbox re-posts notes and re-summarizes calls that failed.
# OUTBOX_ENABLED=true
# OUTBOX_INTERVAL_MINUTES=5
# OUTBOX_MAX_ATTEMPTS=5

# --- Uysot CRM OAuth integration (§11 settings) ---
# Uysot's OAuth2 endpoints (authorization-code flow, same shape as Google's) — the
# same for every company; each company enters its own client_id/client_secret via
# PUT /api/settings/integrations/uysot. NOT YET KNOWN — leave blank until Uysot
# provides them; the feature stays inert (not broken) while blank.
# UYSOT_OAUTH_AUTHORIZE_URL=
# UYSOT_OAUTH_TOKEN_URL=
# UYSOT_OAUTH_REDIRECT_URI=https://your-domain/api/settings/integrations/uysot/callback
# AES-256 key (base64, 32 bytes) that encrypts client_secret/access/refresh tokens at
# rest — required for the integrations feature, independent of API_KEY/JWT_SECRET.
#   openssl rand -base64 32
# ENCRYPTION_SECRET_KEY=

# --- Notifications (§11 settings) ---
# One Telegram bot for the whole deployment; a company only supplies its own chat_id
# via PUT /api/settings/notifications. Blank = the Telegram channel is skipped
# everywhere, same fail-closed posture as every other credential here.
# TELEGRAM_BOT_TOKEN=
# Email/webhook channels reuse the SMTP settings already used for scheduled reports
# (spring.mail.* — SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD) and need no config here.

# --- Operator transfer (§11.6) ---
# Endpoint to ring on transfer: a direct agent (PJSIP/operator) or the queue
# (Local/support@operators). Add real agents to asterisk/etc/asterisk/queues.conf.
OPERATOR_ENABLED=true
OPERATOR_ENDPOINT=Local/support@operators
