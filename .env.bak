# --- LLM dialog (Gemini yoki OpenAI) ---
GEMINI_API_KEY=AQ.Ab8RN6Kg-c2zm5dxUzQrD0dhRR3kfVUs4d9-eXiIKvfN38nuNg
# Bitta kalit: cascade chat, OpenAI Realtime, STT va TTS ham shundan foydalanadi.
OPENAI_API_KEY=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
# openai ga qaytarish uchun: LLM_CHAT_PROVIDER=openai va LLM_DIALOG_MODEL=gpt-5.6-luna.
LLM_CHAT_PROVIDER=google-genai
LLM_DIALOG_MODEL=gemini-3.8-flash
SUMMARY_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=LOW

# --- Realtime (speech-to-speech) engines ---
REALTIME_ENABLED=true
# Global fallback (har bir kompaniya o'z sozlamalarida ham tanlay oladi):
# REALTIME_PROVIDER=pipecat

# --- Pipecat Cloud ---
# Pipecat Cloud Console -> API Keys -> Public bo'limidan olingan kalit (pk_...):
PIPECAT_CLOUD_API_KEY=pk_9c8c2372-dc33-4f54-9dcb-68fc957c197c
REALTIME_PIPECAT_AGENT=phone-agent
# (Eslatma: LLM, STT va TTS modellari kompaniya tomonidan Company Settings -> Engine Config orqali sozlanadi)
# Agar maxsus shaxsiy WebSocket gateway ishlatilsa:
# REALTIME_PIPECAT_WS_URL=

# true = facts (debt amount, due date...) go straight into the system prompt instead of
# being fetched one at a time via getCallFact
REALTIME_FACTS_IN_PROMPT=true

# --- VAD / barge-in (Silero) ---
# VAD_MODEL_PATH left unset: docker-compose defaults it to /app/silero_vad.onnx,
# the model the Dockerfile bakes into the image at build time.

# --- File storage (MinIO) ---
STORAGE_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=files

# --- CRM write-back (Uysot) ---
CRM_ENABLED=true
# Unset = docker-compose default (https://api.service.app.uysot.uz)
# CRM_BASE_URL=
CRM_API_TOKEN=

# --- Operator transfer (§11.6) ---
OPERATOR_ENABLED=true
OPERATOR_ENDPOINT=Local/support@operators

